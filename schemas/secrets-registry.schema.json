{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BloclabsHQ/fabricbloc-branch-policy/schemas/secrets-registry.schema.json",
  "title": "FabricBloc secrets registry (Aether §5, names only)",
  "type": "object",
  "required": ["schema_version", "policy_id", "entries"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "policy_id": { "type": "string", "const": "fabricbloc-secrets-registry" },
    "calibrated_from": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "name",
        "type",
        "kind",
        "stored_as",
        "github",
        "onepassword_item",
        "runtime_env",
        "permissions",
        "owner_role",
        "custodian",
        "rotation_days",
        "last_rotated",
        "status",
        "replaces"
      ],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": ["string", "null"] },
        "kind": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["app", "pat", "slack", "oauth", "api_key", "op_sa", "mac"]
            }
          ]
        },
        "stored_as": {
          "type": "string",
          "enum": ["secret", "variable", "runtime_env"]
        },
        "github": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/github_location" }
        },
        "onepassword_item": { "type": ["string", "null"] },
        "runtime_env": { "type": ["string", "null"] },
        "permissions": { "type": ["string", "null"] },
        "owner_role": { "type": ["string", "null"] },
        "custodian": { "type": ["string", "null"] },
        "rotation_days": { "type": ["integer", "null"] },
        "last_rotated": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["planned", "active", "deprecated(until)", "removed", "superseded"]
        },
        "replaces": { "type": ["string", "null"] },
        "expires": { "type": ["string", "null"] },
        "replace_with": { "type": ["string", "null"] }
      }
    },
    "github_location": {
      "type": "object",
      "required": ["scope", "repos", "environment", "visibility"],
      "additionalProperties": true,
      "properties": {
        "scope": { "type": "string", "enum": ["org", "repo", "environment"] },
        "repos": {
          "type": ["array", "null"],
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
        },
        "environment": { "type": ["string", "null"] },
        "visibility": { "type": ["string", "null"], "enum": ["all", "private", null] }
      }
    }
  }
}
