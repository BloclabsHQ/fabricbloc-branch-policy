{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BloclabsHQ/fabricbloc-branch-policy/schemas/secrets-registry.schema.json",
  "title": "FabricBloc secrets registry (names only)",
  "type": "object",
  "required": ["schema_version", "policy_id", "entries"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "policy_id": { "type": "string", "const": "fabricbloc-secrets-registry" },
    "calibrated_from": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "status", "github_locations", "onepassword_item", "notes"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "status": { "type": "string", "enum": ["live", "deprecated", "planned"] },
        "onepassword_item": { "type": ["string", "null"] },
        "notes": { "type": "string", "minLength": 1 },
        "intentional_duplicate": { "type": "boolean" },
        "duplicate_policy": { "type": "string" },
        "github_locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": true,
      "properties": {
        "scope": { "type": "string", "enum": ["org", "repo", "environment"] },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "visibility": { "type": "string", "enum": ["all", "private"] },
        "kind": {
          "type": "string",
          "enum": ["actions_secret", "actions_variable", "environment_secret"],
          "default": "actions_secret"
        },
        "overrides_org": { "type": "boolean" }
      }
    }
  }
}
